# AcostasPool - environment variables
#
# Copy this file to .env for local development. Blank values count as unset.
# The full inventory and the validation rules live in src/lib/config/env.ts;
# src/instrumentation.ts runs them when the server starts (next dev / next start),
# prints warnings for degraded features and, only with NODE_ENV=production,
# aborts the start when a required variable is missing or invalid.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma
# (postgresql://user:password@host:5432/database?schema=public)
DATABASE_URL=
# Random secret used to sign session tokens. At least 32 characters,
# e.g. `openssl rand -base64 48`. Rotating it signs every user out.
AUTH_SECRET=
# Public origin of the app (no trailing path). Used in e-mail links and by the
# cron worker to call internal endpoints.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cron worker / internal endpoints (recommended)
# ---------------------------------------------------------------------------
# Shared secret that scripts/cron-worker.ts sends as the `x-cron-secret` header
# to POST /api/internal/routes/assistant/auto-optimize. Without it the endpoint
# rejects every call and the worker skips the daily route optimization.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Transactional e-mail (SMTP) - recommended
# ---------------------------------------------------------------------------
# Used for invitations, password resets, invoices, job photos, quote requests
# and the worker digests. Without SMTP_HOST/SMTP_USER/SMTP_PASS nothing is sent.
SMTP_HOST=
# Defaults to 587
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER
SMTP_FROM=
# Inbox for quote requests and public-integration replies; defaults to SMTP_USER
CONTACT_INBOX_EMAIL=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# `local` stores files under public/ (single instance only); `s3` uses AWS S3.
# With s3 every AWS_* variable below is required.
STORAGE_DRIVER=local
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional public base URL (CDN) for stored assets when using s3;
# defaults to https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_CDN_URL=

# ---------------------------------------------------------------------------
# Realtime notifications (Pusher) - recommended in production
# ---------------------------------------------------------------------------
# Without the four server variables the app falls back to an in-memory bus that
# only reaches browsers connected to the same instance (SSE stream at
# /api/notifications/stream) and nothing published by other processes arrives.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Browser side; must match PUSHER_KEY / PUSHER_CLUSTER. Inlined at build time,
# so a change requires a new build.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# Optional custom alert sound; defaults to /sounds/notification.mp3
NEXT_PUBLIC_NOTIFICATION_SOUND_URL=

# ---------------------------------------------------------------------------
# Google Maps
# ---------------------------------------------------------------------------
# Browser key used by the address autocomplete. Restrict it to your website
# origins (Maps JavaScript API + Places API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key used by geocoding and the route assistant (Geocoding API).
# Restrict it by IP or by API; never reuse the browser key.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional alias of the server key for environments that use the generic name.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Business settings
# ---------------------------------------------------------------------------
# IANA time zone for scheduling, digests and reports; defaults to America/New_York.
# NEXT_PUBLIC_BUSINESS_TIMEZONE takes precedence when set: keep both equal.
BUSINESS_TIMEZONE=America/New_York
NEXT_PUBLIC_BUSINESS_TIMEZONE=

# ---------------------------------------------------------------------------
# Public landing page (optional)
# ---------------------------------------------------------------------------
# YouTube video id embedded in the landing page
NEXT_PUBLIC_LANDING_YOUTUBE_ID=
# Background video of the services section; set ENABLED to `false` to hide it
# (defaults to enabled)
NEXT_PUBLIC_LANDING_SERVICES_BG_VIDEO_SRC=
NEXT_PUBLIC_LANDING_SERVICES_BG_VIDEO_ENABLED=

# ---------------------------------------------------------------------------
# Seed accounts (npm run db:seed) - development and CI only
# ---------------------------------------------------------------------------
# scripts/seed.cjs has built-in demo defaults; override them here. Never reuse
# these credentials in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TECH_EMAIL=
SEED_TECH_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=

# ---------------------------------------------------------------------------
# Test tooling (optional)
# ---------------------------------------------------------------------------
# Base URL for Playwright (npm run test:e2e); defaults to http://localhost:3000
E2E_BASE_URL=
