# Core
DATABASE_URL=
AUTH_SECRET=
APP_URL=http://localhost:3000
CRON_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_INBOX_EMAIL=

# Google Maps
# Client-side key (used by address autocomplete in browser)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side key (used by Route Assistant geocoding in API routes)
# Prefer this key for backend requests.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional alias if you prefer a generic name in some environments.
GOOGLE_MAPS_API_KEY=

# Business settings
BUSINESS_TIMEZONE=America/New_York

# Stripe (use TEST MODE keys for local/preview development - never live keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
