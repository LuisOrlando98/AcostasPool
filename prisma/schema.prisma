generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECH
  CUSTOMER
}

enum Locale {
  ES
  EN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
}

enum JobStatus {
  SCHEDULED
  PENDING
  ON_THE_WAY
  IN_PROGRESS
  COMPLETED
}

enum JobType {
  ROUTINE
  ON_DEMAND
}

enum JobPriority {
  NORMAL
  URGENT
}

enum ServiceType {
  WEEKLY_CLEANING
  FILTER_CHECK
  CHEM_BALANCE
  EQUIPMENT_CHECK
}

enum PlanFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum InvoiceTheme {
  STANDARD
  SPECIAL
  ESTIMATE
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DigestWindow {
  MORNING
  MIDDAY
  EVENING
}

enum PublicIntegrationDecision {
  ACCEPT
  DECLINE
}

enum ResetTokenPurpose {
  INVITE
  PASSWORD_RESET
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  locale       Locale   @default(EN)
  isActive     Boolean  @default(true)
  isDeveloper  Boolean  @default(false)
  avatarUrl    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  technician Technician?
  customer   Customer?
  requestedJobs Job[] @relation("UserRequestedJobs")
  auditLogs  AuditLog[]
  passwordResetTokens PasswordResetToken[]
  notificationPreferences NotificationPreference[]
  actedNotifications Notification[] @relation("NotificationActor")
  customerDocuments CustomerDocument[] @relation("CustomerDocumentUploader")

  @@index([isDeveloper])
}

model Technician {
  id     String  @id @default(cuid())
  userId String  @unique
  phone  String?
  notes  String?
  colorHex String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]
  servicePlans ServicePlan[]
  digests TechDigest[]
  digestItems TechDigestItem[]
  emailLogs EmailLog[]
}

model Customer {
  id            String        @id @default(cuid())
  userId        String?       @unique
  nombre        String
  apellidos     String
  email         String
  telefono      String
  telefonoSecundario String?
  idiomaPreferencia Locale        @default(EN)
  estadoCuenta  AccountStatus @default(ACTIVE)
  tipoCliente   CustomerType @default(RESIDENTIAL)
  allowWeekendBooking Boolean @default(false)
  pauseServicesFrom DateTime? @db.Timestamptz(3)
  direccionLinea1 String?
  direccionLinea2 String?
  ciudad        String?
  estadoProvincia String?
  codigoPostal  String?
  notas         String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  properties    Property[]
  jobs          Job[]
  invoices      Invoice[]
  documents     CustomerDocument[]
  notifications Notification[]
  servicePlans  ServicePlan[]
  emailLogs     EmailLog[]

  @@index([email])
}

model Property {
  id               String   @id @default(cuid())
  customerId       String
  name             String?
  address          String
  poolType         String?
  poolVolumeGallons Int?
  waterType        String?
  surfaceType      String?
  filterType       String?
  pumpType         String?
  heaterType       String?
  hasSpa           Boolean  @default(false)
  sanitizerType    String?
  accessInfo       String?
  locationNotes    String?
  serviceStartDate DateTime? @db.Timestamptz(3)
  paymentDay       Int?
  servicePrice     Decimal? @db.Decimal(10, 2)
  paymentType      String?
  paymentNotes     String?
  equipmentDetails String?
  referencePhotos  Json?
  lat              Float?
  lng              Float?
  geocodedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs     Job[]
  servicePlans ServicePlan[]

  @@index([customerId])
}

model Job {
    id            String    @id @default(cuid())
    customerId    String
    propertyId    String
    technicianId  String?
    serviceTierId String?
    scheduledDate DateTime @db.Timestamptz(3)
    status        JobStatus @default(SCHEDULED)
    type          JobType   @default(ROUTINE)
    priority      JobPriority @default(NORMAL)
  serviceType   ServiceType @default(WEEKLY_CLEANING)
  estimatedDurationMinutes Int?
  sortOrder     Int?
  notes         String?
  customerNotes String?
  checklist     Json?
  planId        String?
  startedAt     DateTime? @db.Timestamptz(3)
  completedAt   DateTime? @db.Timestamptz(3)
  requestedAt   DateTime? @db.Timestamptz(3)
  requestedByUserId String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

    customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
    property   Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
    technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
    serviceTier ServiceTier? @relation(fields: [serviceTierId], references: [id], onDelete: SetNull)
    plan       ServicePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
    requestedBy User? @relation("UserRequestedJobs", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  photos     JobPhoto[]
  invoices   Invoice[]
  digestItems TechDigestItem[]
  emailLogs EmailLog[]

  @@index([scheduledDate])
    @@index([technicianId, scheduledDate])
    @@index([customerId, scheduledDate])
    @@index([status])
    @@index([serviceTierId])
  }

  model ServiceTier {
    id        String   @id @default(cuid())
    name      String
    checklist Json?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now()) @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @db.Timestamptz(3)

    jobs  Job[]
    plans ServicePlan[]

    @@unique([name])
  }

  model ServicePlan {
    id            String       @id @default(cuid())
    customerId    String
    propertyId    String
    technicianId  String?
    serviceTierId String?
    name          String
    frequency     PlanFrequency
    serviceType   ServiceType
  priority      JobPriority  @default(NORMAL)
  nextRunAt     DateTime @db.Timestamptz(3)
  preferredTime String?
  estimatedDurationMinutes Int?
  checklist     Json?
  notes         String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

    customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
    property   Property   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
    technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
    serviceTier ServiceTier? @relation(fields: [serviceTierId], references: [id], onDelete: SetNull)
    jobs       Job[]

    @@index([isActive, nextRunAt])
    @@index([customerId])
    @@index([propertyId])
    @@index([technicianId])
  }

model JobPhoto {
  id                String   @id @default(cuid())
  jobId             String
  takenAt           DateTime @default(now()) @db.Timestamptz(3)
  uploadedAt        DateTime @default(now()) @db.Timestamptz(3)
  url               String
  visibleToCustomer Boolean  @default(true)
  uploadedByUserId  String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Invoice {
  id        String        @id @default(cuid())
  customerId String
  jobId     String?
  number    String        @unique
  status    InvoiceStatus @default(DRAFT)
  theme     InvoiceTheme  @default(STANDARD)
  lineItems Json?
  notes     String?
  subtotal  Decimal       @db.Decimal(10, 2)
  tax       Decimal       @db.Decimal(10, 2) @default(0)
  total     Decimal       @db.Decimal(10, 2)
  pdfUrl    String?
  sentAt    DateTime? @db.Timestamptz(3)
  paidAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model CustomerDocument {
  id               String   @id @default(cuid())
  customerId       String
  uploadedByUserId String?
  title            String
  description      String?
  category         String   @default("GENERAL")
  fileUrl          String
  mimeType         String?
  sizeBytes        Int?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("CustomerDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([uploadedByUserId, createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  customerId String?
  recipientUserId String?
  recipientRole Role            @default(CUSTOMER)
  channel   NotificationChannel @default(EMAIL)
  eventType String
  severity  NotificationSeverity @default(INFO)
  status    NotificationStatus @default(QUEUED)
  attempts  Int                @default(0)
  lastAttemptAt DateTime?      @db.Timestamptz(3)
  payload   Json?
  sentAt    DateTime? @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  actorUserId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actorUser User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([recipientRole, createdAt])
  @@index([customerId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([actorUserId])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType])
}

model TechDigest {
  id           String       @id @default(cuid())
  technicianId String
  routeDate    DateTime @db.Timestamptz(3)
  window       DigestWindow
  scheduledFor DateTime @db.Timestamptz(3)
  status       NotificationStatus @default(QUEUED)
  sentAt       DateTime? @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  items       TechDigestItem[]
  emailLogs   EmailLog[]

  @@unique([technicianId, routeDate, window])
  @@index([technicianId, routeDate])
}

model TechDigestItem {
  id           String   @id @default(cuid())
  technicianId String
  jobId        String
  routeDate    DateTime @db.Timestamptz(3)
  changeType   String
  payload      Json?
  digestId     String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  digest     TechDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@index([technicianId, routeDate])
  @@index([jobId])
}

model EmailLog {
  id             String             @id @default(cuid())
  recipientEmail String
  recipientName  String?
  recipientRole  String
  subject        String
  bodyText       String
  bodyHtml       String?
  status         NotificationStatus @default(QUEUED)
  attempts       Int                @default(0)
  errorMessage   String?
  sentAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  customerId     String?
  technicianId   String?
  jobId          String?
  digestId       String?
  metadata       Json?

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  job        Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  digest     TechDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([customerId])
  @@index([technicianId])
  @@index([jobId])
}

model AuditLog {
  id       String   @id @default(cuid())
  userId   String?
  actorEmail String?
  actorName  String?
  action   String
  entity   String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  purpose   ResetTokenPurpose @default(PASSWORD_RESET)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([purpose, userId, createdAt])
  @@index([expiresAt, usedAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([resetAt])
}

model SiteSettings {
  id               String   @id @default("default")
  instagramUrl     String?
  facebookUrl      String?
  whatsappUrl      String?
  xUrl             String?
  youtubeUrl       String?
  tiktokUrl        String?
  landingYoutubeUrl String?
  landingPromoCopy Json?
  emailTemplates   Json?
  invoiceTemplate  Json?
  routeAssistantConfig Json?
  complianceContent Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
}

model PublicIntegrationResponse {
  id            String                    @id @default(cuid())
  token         String
  clientName    String
  clientEmail   String
  companyName   String?
  decision      PublicIntegrationDecision
  acceptTerms   Boolean                   @default(false)
  comments      String?
  signatureDataUrl String                 @db.Text
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  @@unique([token, clientEmail])
  @@index([token, createdAt])
}
