{
  "name": "acostaspool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "worker:cron": "tsx scripts/cron-worker.ts",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:create-admin": "node scripts/create-admin.cjs",
    "db:create-developer": "node scripts/create-developer.cjs",
    "db:seed": "node scripts/seed.cjs",
    "db:backfill-notifications": "node scripts/backfill-notifications.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.917.0",
    "@prisma/client": "^5.19.1",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^2.4.3",
    "jose": "^5.10.0",
    "luxon": "^3.6.0",
    "next": "16.1.6",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "prisma": "^5.19.1",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
